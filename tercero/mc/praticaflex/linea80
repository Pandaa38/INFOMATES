%{
#include <iostream>
#include <fstream>
#include <sstream>
#include <vector>
#include <cstring>

using namespace std;

// 1. DEFINICIÓN DEL ENUMERADO
enum TipoContenido {
    CODIGO,             // Texto normal de C++
    CADENA,             // "Texto entre comillas"
    COMENTARIO_LINEA,   // // Comentario de una línea
    COMENTARIO_BLOQUE   // /* Comentario de bloque */
};

const unsigned int LIMITE = 80;
int columna_actual = 0;
ostringstream salida_buffer;

void imprimir_seguro(const char* texto, TipoContenido tipo = CODIGO) {
    int longitud = strlen(texto);

    if (tipo == CADENA) {
        salida_buffer << '"'; // Comilla inicial
        columna_actual++;
        
        for (int i = 1; i < longitud - 1; i++) { 
            if (columna_actual >= LIMITE) {
                salida_buffer << '"' << endl << '"';
                columna_actual = 1; 
            }
            salida_buffer << texto[i];
            columna_actual++;
        }
        salida_buffer << '"';
        columna_actual++;
    }
    
    else if (tipo == COMENTARIO_LINEA) {
        if (columna_actual + longitud > LIMITE) {
            salida_buffer << endl;
            salida_buffer << "// "; 
            columna_actual = 3;     // sumamos 3 por los "// "
        }
        salida_buffer << texto;
        columna_actual += longitud;
    }

    else if (tipo == COMENTARIO_BLOQUE) {
        if (columna_actual + longitud > LIMITE) {
            salida_buffer << endl;
            salida_buffer << " * ";
            columna_actual = 0;
        }
        salida_buffer << texto;
        columna_actual += longitud;
    }

    else { // CODIGO
        if (columna_actual + longitud > LIMITE) {
            salida_buffer << endl;
            columna_actual = 0;
        }
        salida_buffer << texto;
        columna_actual += longitud;
    }
}

%}

%option noyywrap

%x ESTADO_COMENTARIO_LINEA
%x ESTADO_COMENTARIO_BLOQUE

%%

\n {
    salida_buffer << endl;
    columna_actual = 0;
}

    /* Detectar inicio de comentario de línea // */
"//" {
    salida_buffer << "//";
    columna_actual += 2;
    BEGIN(ESTADO_COMENTARIO_LINEA);
}

    /* Detectar inicio de comentario de bloque /* */
"/*" {
    salida_buffer << "/*";
    columna_actual += 2;
    BEGIN(ESTADO_COMENTARIO_BLOQUE);
}

    /* Detectar cadenas completas (como antes) */
\"[^\"]*\" {
    imprimir_seguro(yytext, CADENA);
}

    /* Espacios (tabuladores y espacios simples) */
[ \t]+ {
    if (columna_actual >= LIMITE) {
        salida_buffer << endl;
        columna_actual = 0;
    } else {
        salida_buffer << " ";
        columna_actual++;
    }
}

    /* Código Normal */
[^ \t\n\"/]+ {
    imprimir_seguro(yytext);
}
    /* Caracteres sueltos que no sean espacios ni inicio de comentario (ej: la barra / sola) */
. {
    imprimir_seguro(yytext);
}


    /* --- REGLAS DENTRO DE COMENTARIO DE LÍNEA () --- */

<ESTADO_COMENTARIO_LINEA>\n {
    salida_buffer << endl;
    columna_actual = 0;
    BEGIN(INITIAL); // El salto de línea termina el comentario
}

<ESTADO_COMENTARIO_LINEA>[ \t]+ {
    salida_buffer << " "; // Simplificamos espacios en comentarios
    columna_actual++;
}

<ESTADO_COMENTARIO_LINEA>[^ \t\n]+ { 
    imprimir_seguro(yytext, COMENTARIO_LINEA);
}

    /* --- REGLAS DENTRO DE COMENTARIO DE BLOQUE --- */

<ESTADO_COMENTARIO_BLOQUE>"*/" {
    imprimir_seguro("*/", COMENTARIO_BLOQUE);
    BEGIN(INITIAL);
}

<ESTADO_COMENTARIO_BLOQUE>\n {
    salida_buffer << endl;
    columna_actual = 0;
}

<ESTADO_COMENTARIO_BLOQUE>[ \t]+ {
     salida_buffer << yytext;  // Preservar espacios originales
     columna_actual += strlen(yytext);
}

<ESTADO_COMENTARIO_BLOQUE>[^ \t\n*]+ {
    imprimir_seguro(yytext, COMENTARIO_BLOQUE);
}

<ESTADO_COMENTARIO_BLOQUE>. {
    imprimir_seguro(yytext, COMENTARIO_BLOQUE);
}

%%

int main(int argc, char *argv[]) {

    if (argc < 2) {
        cerr << "Uso: " << argv[0] << " <archivo_fuente.cpp>" << endl;
        return 1;
    }

    string nombre_archivo = argv[1];
    string nombre_archivo_temporal = nombre_archivo + ".tmp";

    // Abrir archivo de entrada
    FILE *archivo_entrada = fopen(nombre_archivo.c_str(), "r");
    if (!archivo_entrada) {
        cerr << "Error: No se pudo abrir el archivo '" << nombre_archivo << "'." << endl;
        return 1;
    }

    yyin = archivo_entrada;
    yylex();
    fclose(archivo_entrada);

    // Escribir al archivo temporal
    ofstream archivo_salida(nombre_archivo_temporal);
    if (!archivo_salida) {
        cerr << "Error: No se puede escribir en " << nombre_archivo_temporal << endl;
        return 1;
    }
    
    archivo_salida << salida_buffer.str();
    archivo_salida.close();

    // Reemplazar el archivo original con el temporal
    remove(nombre_archivo.c_str());
    rename(nombre_archivo_temporal.c_str(), nombre_archivo.c_str());
    
    return 0;
}