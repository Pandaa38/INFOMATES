/**
 * @brief Función principal.
 * Gestiona la apertura del archivo de entrada, crea un archivo temporal
 * para volcar la salida y redirige cout.
 */
int main(int argc, char *argv[]) {

    // 1. Validación de argumentos de entrada
    if (argc < 2) {
        std::cerr << "Uso: " << argv[0] << " <archivo_fuente.cpp>" << std::endl;
        return 1;
    }
    
    // 2. Configuración de nombres de archivo
    // Se crea un archivo temporal para escribir la salida procesada antes de sobrescribir.
    std::string nombre_archivo = argv[1];
    std::string nombre_archivo_temporal = nombre_archivo + ".tmp";
    
    // 3. Apertura del archivo de lectura
    FILE *archivo_entrada = fopen(nombre_archivo.c_str(), "r");
    if (!archivo_entrada) {
        std::cerr << "Error: No se pudo abrir el archivo '" << nombre_archivo << "'." << std::endl;
        return 1;
    }

    // 4. Preparación del archivo de escritura 
    std::ofstream archivo_salida(nombre_archivo_temporal);
    if (!archivo_salida.is_open()) {
        std::cerr << "Error: No se pudo crear el archivo temporal." << std::endl;
        fclose(archivo_entrada);
        return 1;
    }
    
    // 5. Redirección de flujos (Salida Estándar -> Archivo)
    // Guardamos el buffer original de cout para restaurarlo después.
    // Redirigimos cout para que todas las impresiones de yylex() vayan al archivo temporal.
    std::streambuf *buffer_original = std::cout.rdbuf(archivo_salida.rdbuf());
    
    // 6. Ejecución del Analizador Léxico
    yyin = archivo_entrada; // Asignamos el archivo abierto a la variable global de Flex
    yylex();                // Iniciamos el escaneo
    
    // 7. Restauracion de la salida estándar y cierre del archivo
    std::cout.rdbuf(buffer_original); // Restauramos la salida estándar a la consola
    archivo_salida.close();           // Cerramos el ofstream
    fclose(archivo_entrada);          // Cerramos el FILE*
    
    // 8. Eliminamos el archivo original y renombramos el archivo temporal
    remove(nombre_archivo.c_str());
    rename(nombre_archivo_temporal.c_str(), nombre_archivo.c_str());
    
    return 0;
}